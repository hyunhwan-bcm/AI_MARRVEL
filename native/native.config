// Run AIM without containers, using the pixi environments in ../pixi.toml.
//   pixi install --all && pixi run -e vep fetch-vep && pixi run -e r install-ontologysimilarity
//   NXF_VER=24.10.5 nextflow -c native/native.config run main.nf -profile debug --ref_dir ... --ref_ver hg38 ...
//
// Each process gets the environment matching the image it would have run in; the locale matches
// that image too, because `sort | join` and R's merge() ordering depend on it.

docker.enabled = false
singularity.enabled = false

process {
    // conf/base.config reserves 25 GB per task, so a 32 GB machine runs one task at a time.
    // Measured peaks are under 2 GB per task on the test inputs (whole-exome chromosome tasks
    // included); the local executor only schedules by this, it does not enforce it.
    // ClinVar sample, --rust --rust_vep: 2 min 47 s at 25 GB, 47 s at 4 GB, outputs unchanged.
    // Override with `-c` for unusually large inputs (VEP itself has needed up to ~7 GB).
    memory = 4.GB

    // zhandongliulab/aim-lite:1.2 (LANG=C.UTF-8; C gives the same byte-order collation on macOS).
    // PYTHONHASHSEED=0 makes set iteration order, and so phrank's float summation order, the same
    // on every run; unpinned, phrank scores differ in the last digit between runs.
    beforeScript = "eval \"\$(pixi shell-hook --manifest-path ${projectDir}/pixi.toml -e py --no-install)\"; export LC_ALL=C LANG=C PYTHONHASHSEED=0"

    // zhandongliulab/aim-lite-r (LANG=en_US.UTF-8)
    withName: 'HPO_SIM|ANNOTATE_TIER' {
        beforeScript = "eval \"\$(pixi shell-hook --manifest-path ${projectDir}/pixi.toml -e r --no-install)\"; export LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8"
    }

    // ensemblorg/ensembl-vep:release_104.3 (LC_ALL=en_US.UTF-8)
    withName: 'ANNOTATE_BY_VEP' {
        beforeScript = "eval \"\$(pixi shell-hook --manifest-path ${projectDir}/pixi.toml -e vep --no-install)\"; export LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 AIM_VEP_BIN=\$AIM_VEP_HOME/vep"
    }
}
